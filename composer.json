{
    "name": "koriym/wasm-todo",
    "description": "A BEAR.Sunday todo app that runs entirely in the browser via php-wasm",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "bear/package": "^1.7"
    },
    "autoload": {
        "psr-4": {
            "WasmTodo\\App\\": "src"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.3"
    },
    "scripts": {
        "serve": "php -S 127.0.0.1:8080 -t public",
        "compile": "php bin/compile.php"
    }
}
